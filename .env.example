# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# URL publique (liens d'invitation, redirections Stripe / NOWPayments)
PUBLIC_URL=https://your-app.up.railway.app
# Dossier de la base SQLite. Sur Railway/Render, monte un volume persistant ici
# sinon les comptes et soldes sont effacés à chaque déploiement.
DATA_DIR=/data

# ── Sécurité ─────────────────────────────────────────────────────────────────
# Signe les sessions et les jetons Supporter. OBLIGATOIRE en production :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# Durée des sessions (jours)
SESSION_DAYS=30
# Protège /admin.html et /api/admin (retraits, ajustements). Laisser vide = admin désactivé.
ADMIN_TOKEN=

# ── Arène à mise ─────────────────────────────────────────────────────────────
# demo (défaut) : crédits démo sans valeur.
# nowpayments  : dépôts crypto réels. Ne l'active qu'après avoir réglé le cadre légal
#                (ANJ, MiCA, KYC) : voir DEPLOY.md.
PAYMENTS_MODE=demo
# Garde-fou : doit valoir true pour que PAYMENTS_MODE=nowpayments soit pris en compte.
ARENA_REAL_MONEY=false
# Paliers de mise (en USD/USDC, séparés par des virgules)
ARENA_TIERS=0.25,1,5,20
# Commission de la maison en points de base (500 = 5 %)
HOUSE_FEE_BPS=500
ARENA_MIN_PLAYERS=2
ARENA_MAX_PLAYERS=10
ARENA_COUNTDOWN_SECONDS=20
ARENA_MATCH_SECONDS=300
ARENA_CASHOUT_SECONDS=3
DEMO_FAUCET_AMOUNT=10
DEMO_FAUCET_HOURS=6
MIN_DEPOSIT=5
MAX_DEPOSIT=500
MIN_WITHDRAWAL=5
WITHDRAW_NETWORKS=USDC-SOL,USDC-POLYGON,USDC-ERC20,USDT-TRC20

# ── NOWPayments (https://nowpayments.io) ─────────────────────────────────────
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# true = https://api-sandbox.nowpayments.io pour les tests
NOWPAYMENTS_SANDBOX=true

# ── Stripe (pack Supporter) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Publicité & mesure d'audience ────────────────────────────────────────────
ADSENSE_CLIENT=ca-pub-5085065422144308
# Identifiants des blocs d'annonces (AdSense → Annonces → Par bloc). Vide = pas de pub.
ADSENSE_SLOT_LOBBY=
ADSENSE_SLOT_DEATH=
# Domaine Plausible (statistiques sans cookies), optionnel
PLAUSIBLE_DOMAIN=

# ── Capacité ─────────────────────────────────────────────────────────────────
MAX_ROOMS=40
MAX_PLAYERS_PER_ROOM=30
