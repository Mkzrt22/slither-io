# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# URL publique (liens d'invitation, redirections Stripe, message de connexion wallet)
PUBLIC_URL=https://your-app.up.railway.app
# Dossier de la base SQLite. Sur Railway/Render, monte un volume persistant ici
# sinon les comptes et soldes sont effacés à chaque déploiement.
DATA_DIR=/data

# ── Sécurité ─────────────────────────────────────────────────────────────────
# Signe les sessions et les jetons Supporter. OBLIGATOIRE en production :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# Durée des sessions (jours)
SESSION_DAYS=30
# Protège /admin.html et /api/admin (retraits, ajustements). Laisser vide = admin désactivé.
ADMIN_TOKEN=

# ── Arène à mise ─────────────────────────────────────────────────────────────
# demo (défaut) : crédits démo sans valeur.
# crypto       : dépôts et retraits réels depuis les wallets des joueurs
#                (SOL, ETH, BNB, USDC, TRX, USDT). Voir DEPLOY.md avant de l'activer.
PAYMENTS_MODE=demo
# Garde-fou : doit valoir true pour que PAYMENTS_MODE=crypto soit pris en compte.
ARENA_REAL_MONEY=false
# Paliers de mise en dollars (séparés par des virgules)
ARENA_TIERS=0.25,1,5,20
# Commission de la maison en points de base (500 = 5 %)
HOUSE_FEE_BPS=500
ARENA_MIN_PLAYERS=2
ARENA_MAX_PLAYERS=10
ARENA_COUNTDOWN_SECONDS=20
ARENA_MATCH_SECONDS=300
ARENA_CASHOUT_SECONDS=3
DEMO_FAUCET_AMOUNT=10
DEMO_FAUCET_HOURS=6
# Pays interdits (codes ISO, ex. US,FR,GB). Nécessite Cloudflare (en-tête cf-ipcountry) devant le serveur.
BLOCKED_COUNTRIES=

# ── Crypto (PAYMENTS_MODE=crypto) ────────────────────────────────────────────
# mainnet ou testnet (Solana devnet, Sepolia, BNB testnet, TRON Nile)
CRYPTO_NETWORK=testnet
# Actifs proposés (défaut : tous ceux dont le réseau est configuré)
# SOL, USDC_SOL, ETH, USDC_ETH, BNB, USDC_BSC, TRX, USDT_TRON
CRYPTO_ASSETS=
# Wallets chauds de la maison : génère-les avec `node scripts/new-wallets.js`.
# Avec la clé : dépôts + retraits automatiques. Avec seulement l'adresse (*_HOUSE_ADDRESS) :
# dépôts uniquement, retraits envoyés à la main.
SOLANA_HOT_WALLET_SECRET=
SOLANA_HOUSE_ADDRESS=
EVM_HOT_WALLET_KEY=
EVM_HOUSE_ADDRESS=
TRON_HOT_WALLET_KEY=
TRON_HOUSE_ADDRESS=
# RPC (les publics sont limités : prends un fournisseur pour la prod — Helius, Alchemy, QuickNode, TronGrid…)
SOLANA_RPC_URL=
ETH_RPC_URL=
BSC_RPC_URL=
TRON_RPC_URL=
TRON_API_KEY=
# Marge de conversion sur les cryptos volatiles (50 = 0,5 %), protège des écarts de cours
PRICE_SPREAD_BPS=50
# Frais de retrait facturés au joueur, en dollars par réseau
WITHDRAW_FEES=solana:0.1,ethereum:3,bsc:0.3,tron:1.5
# Retraits automatiques jusqu'à ce montant (USD), au-delà validation manuelle dans /admin.html
AUTO_WITHDRAW_MAX_USD=100
# Total automatique maximum par joueur et par 24 h (USD)
AUTO_WITHDRAW_DAILY_USD=300
MIN_DEPOSIT=1
MAX_DEPOSIT=2000
MIN_WITHDRAWAL=5
# Délai avant qu'un dépôt non confirmé passe en « expiré » (minutes)
DEPOSIT_TIMEOUT_MINUTES=120

# ── Stripe (pack Supporter) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Publicité & mesure d'audience ────────────────────────────────────────────
ADSENSE_CLIENT=ca-pub-5085065422144308
# Identifiants des blocs d'annonces (AdSense → Annonces → Par bloc). Vide = pas de pub.
ADSENSE_SLOT_LOBBY=
ADSENSE_SLOT_DEATH=
# Domaine Plausible (statistiques sans cookies), optionnel
PLAUSIBLE_DOMAIN=

# ── Capacité ─────────────────────────────────────────────────────────────────
MAX_ROOMS=40
MAX_PLAYERS_PER_ROOM=30
