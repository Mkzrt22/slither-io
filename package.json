{
  "name": "neonslither",
  "version": "7.0.0",
  "description": "NeonSlither: multiplayer neon snake arena with an equal-start stake mode",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node server.js",
    "start:env": "node --env-file=.env server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server.js && for f in src/*.js src/*/*.js shared/*.js public/js/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "compression": "^1.7.4",
    "ethers": "^6.17.0",
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "stripe": "^14.0.0",
    "tronweb": "^6.5.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.6.1"
  },
  "optionalDependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3"
  }
}
