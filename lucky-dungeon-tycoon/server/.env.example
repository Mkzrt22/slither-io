# Copy to .env and adjust. Used by docker-compose on your VPS.

# Password for the bundled Postgres container (CHANGE THIS).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Where Caddy serves from. Leave as :80 for HTTP on a bare IP (dev/testing).
# Set to your domain (e.g. tycoon.example.com) to get automatic HTTPS — Caddy
# provisions a Let's Encrypt certificate on first request. Requires DNS pointing
# at this server and ports 80+443 open.
SITE_ADDRESS=:80

# Access-Control-Allow-Origin for the API. "*" is fine while testing. For a
# single web origin you can lock it to e.g. https://tycoon.example.com.
ALLOW_ORIGIN=*

# --- API-only overrides (optional; the compose file sets sensible defaults) ---
# PORT=8787
# DATABASE_URL=postgres://lct:change-me@db:5432/lct
