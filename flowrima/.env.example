# =============================================================================
# Flowrima — variables d'environnement
# Copie ce fichier en `.env.local` (dev) et renseigne chaque valeur.
# Sur Vercel : Project → Settings → Environment Variables.
#
# RÈGLE D'OR : seules les variables préfixées NEXT_PUBLIC_ sont envoyées au
# navigateur. Tout le reste (clés secrètes) ne quitte jamais le serveur.
# =============================================================================

# --- Application -------------------------------------------------------------
# URL publique du site (sans slash final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Langue de l'interface (fr | en). Le français est la langue par défaut.
NEXT_PUBLIC_DEFAULT_LOCALE=fr
# Connexions sociales activées dans Supabase Auth (google, apple), séparées par
# des virgules. Vide = connexion par e-mail uniquement (aucun bouton affiché).
NEXT_PUBLIC_AUTH_PROVIDERS=google
# E-mails (séparés par des virgules) qui ont accès au back-office /app/admin
# en plus du rôle "admin" stocké en base.
ADMIN_EMAILS=

# --- Supabase (base de données, auth, stockage) — région UE (Paris/Francfort) --
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé "service_role" : contourne la RLS. SERVEUR UNIQUEMENT (webhooks, jobs, admin).
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (IA) ------------------------------------------------------------
# console.anthropic.com → API Keys. Sans clé, l'app utilise un fournisseur
# simulé (LLM_PROVIDER=mock) pratique pour développer sans frais.
ANTHROPIC_API_KEY=
# anthropic | mock
LLM_PROVIDER=anthropic
# Modèle utilisé partout (ne pas changer sans relire docs/DECISIONS.md)
ANTHROPIC_MODEL=claude-opus-5-5
# Tarifs en $ par million de tokens (à revérifier sur la page tarifs Anthropic)
LLM_PRICE_INPUT_PER_MTOK=4
LLM_PRICE_OUTPUT_PER_MTOK=20
LLM_PRICE_CACHE_READ_PER_MTOK=0.2
# Taux de change utilisé pour convertir le coût IA en euros dans l'admin
USD_TO_EUR=0.92
# Au-delà de ce nombre de titres, l'analyse ADN passe par la Batch API (-50 %)
DNA_BATCH_THRESHOLD=25

# --- Stripe (paiement) ---------------------------------------------------------
# dashboard.stripe.com → Developers → API keys (mode test d'abord !)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Developers → Webhooks → endpoint https://<ton-domaine>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Identifiants des prix (Products → Artiste → Prices). Voir docs/DEPLOY.md §6.
STRIPE_PRICE_ARTIST_MONTHLY=price_xxx
STRIPE_PRICE_ARTIST_YEARLY=price_xxx
# Pack de crédits prod (paiement unique) — utilisé à partir de la phase 2/3
STRIPE_PRICE_PROD_CREDITS_10=
# Durée de l'essai gratuit du plan Artiste (jours)
STRIPE_TRIAL_DAYS=7

# --- Inngest (file de jobs : analyse ADN, batch) -------------------------------
# app.inngest.com → Manage → Event key / Signing key. En local : `npm run inngest`
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Resend (e-mails transactionnels) ------------------------------------------
RESEND_API_KEY=
# Adresse d'expédition vérifiée dans Resend (domaine vérifié requis en prod)
EMAIL_FROM="Flowrima <bonjour@flowrima.app>"

# --- PostHog (analytics, chargé uniquement après consentement cookies) ---------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Sentry (erreurs) ----------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# --- Plateformes (métadonnées officielles, optionnel) --------------------------
# YouTube Data API v3 : durée et date de sortie des vidéos (sinon oEmbed seul)
YOUTUBE_API_KEY=
